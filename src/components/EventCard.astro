---
import type { EventRecord } from '../lib/model';
import { dateLabel, checkedLabel } from '../lib/dates';
import { issuesFor } from '../lib/events';
import { sourceName } from '../lib/sources';
interface Props { event: EventRecord }
const { event } = Astro.props;
const issues = issuesFor(event);
const bookings = [...new Set(event.sources.map(source => source.bookingUrl).filter((url): url is string => !!url))];
const lastCheck = event.sources.map(source => source.checkedAt).sort().at(-1) ?? null;
---
<article class:list={['event-card', { 'event-cancelled': event.status === 'cancelled' }]} data-event-id={event.id}>
  <div class="event-date" aria-label={event.startDate ? dateLabel(event.startDate, 'EEEE d MMMM yyyy') : 'Date to be confirmed'}>
    {event.startDate ? <><span>{dateLabel(event.startDate, 'ccc')}</span><strong>{dateLabel(event.startDate, 'd')}</strong><span>{dateLabel(event.startDate, 'LLL')}</span></> : <><span>Date</span><strong>?</strong><span>TBC</span></>}
  </div>
  <div class="event-main">
    <div class="event-meta"><span>{event.allDay ? 'All day' : event.startTime ?? 'Time to be confirmed'}</span>{event.endDate && event.endDate !== event.startDate && <span>Until {dateLabel(event.endDate)}</span>}<span>{event.venue ?? 'Venue to be confirmed'}</span></div>
    <h3>{event.title}</h3>
    <div class="tags">{event.categories.map(category => <span class="tag">{category}</span>)}{event.status !== 'scheduled' && <span class="tag status-tag">{event.status.replace('_', ' ')}</span>}</div>
    {event.description && <p class="event-description">{event.description}</p>}
    <div class="event-bottom"><span class="price">{event.price ?? 'Price not listed'}</span><div class="event-links">{bookings.map((url, index) => <a href={url} rel="noopener noreferrer">{bookings.length > 1 ? `Booking option ${index + 1}` : 'Booking details'} <span aria-hidden="true">↗</span></a>)}</div></div>
    <div class="sources-line">Source: {event.sources.map((source, index) => <>{index > 0 && ' · '}<a href={source.url} rel="noopener noreferrer">{sourceName(source.sourceId)} ↗</a></>)}</div>
    {issues.length > 0 && <div class="uncertainty"><span>{issues.join(' · ')}</span><small>Last successful source check: {checkedLabel(lastCheck)}</small></div>}
  </div>
</article>
