    "@playwright/test": "^1.58.0",
    "@types/he": "^1.2.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
